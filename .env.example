NODE_ENV=development
APP_NAME=onevibe

# HTTP API (Fastify)
API_HOST=0.0.0.0
API_PORT=3000
# Public origin for Swagger + media URLs (GET /media/*). Required on live —
# otherwise browsers get http://127.0.0.1:PORT/media/... which fails.
# Local: http://127.0.0.1:3000  |  Live: https://onevibe.walit.in
API_PUBLIC_URL=https://onevibe.walit.in
# Browser CORS allowlist (comma-separated). Empty = onevibe production/staging/control + local Vite.
# Localhost / 127.0.0.1 (any port) is **always** allowed so local webapp can use live API.
# Built-in includes control.onevibe.ai (admin panel).
# Extra: CORS_ORIGINS=https://onevibeapp.walit.in,https://app.example.com
# Dev open all: CORS_ORIGINS=*
CORS_ORIGINS=
# v1,v2 = stable | v3 = development
API_ENABLED_VERSIONS=v1,v2,v3
API_DEFAULT_VERSION=v1

# Realtime (Socket.IO — separate process)
SOCKET_HOST=0.0.0.0
SOCKET_PORT=3001

# Staff Admin API (optional standalone process — usually mounted on main API same port)
# ADMIN_API_HOST=0.0.0.0
# ADMIN_API_PORT=3002
# ADMIN_API_PUBLIC_URL=http://127.0.0.1:3002

# Webapp (Vite) — copy into webapp/.env
# VITE_API_BASE_URL=http://127.0.0.1:3000
# VITE_SOCKET_URL=http://127.0.0.1:3001
# Or build URL from parts (used when VITE_SOCKET_URL is empty):
# VITE_SOCKET_HOST=127.0.0.1
# VITE_SOCKET_PORT=3001
# VITE_SOCKET_PROTOCOL=http

# Admin panel (Vite) — copy into adminpanel/.env
# Local: VITE_API_BASE_URL=http://127.0.0.1:3000/api/admin
# Live: VITE_API_BASE_URL=https://production.onevibe.ai/api/admin
# VITE_API_BASE_URL=http://127.0.0.1:3000/api/admin
# VITE_SOCKET_URL=http://127.0.0.1:3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=onevibe
DB_PASSWORD=onevibe
DB_NAME=onevibe
DB_SSL=false

# Live onevibeapp source for: npm run db:seed:onevibeapp
# SOURCE_DB_HOST=127.0.0.1
# SOURCE_DB_PORT=5432
# SOURCE_DB_USER=postgres
# SOURCE_DB_PASSWORD=root
# SOURCE_DB_NAME=onevibeapp
# SOURCE_DB_SCHEMA=yandexgram

DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Redis (cache + Socket.IO adapter / pub-sub)
# true = use Redis | false = skip cache, pub/sub, Socket Redis adapter
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=onevibe:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RETRIES_PER_REQUEST=3

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Login is single-device: a new login kicks every other session/socket/push.
AUTH_MAX_ACTIVE_DEVICES=1

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=onevibe-media
# true = use CloudFront/CDN in publicUrl | false = local API /media proxy
S3_CLOUDFRONT_ENABLED=false
AWS_CLOUDFRONT_URL=https://d33otx4ywdxk3j.cloudfront.net
S3_PUBLIC_BASE_URL=https://d33otx4ywdxk3j.cloudfront.net

# Linkgram-compatible media Lambdas (S3-event invoke payload)
# Video: ffmpeg frame @ 0.01s → WebP thumb (+ HLS). Empty = skip.
AWS_VIDEO_LAMBDA_FUNCTION_NAME=
AWS_IMAGE_LAMBDA_FUNCTION_NAME=
# true = API invokes Lambda after video /complete (and on POST /media/:id/process)
# false = wait for S3-triggered WebP, then fallback-invoke if missing
MANUAL_LAMBDA_TRIGGER=true

# Twilio (SMS / phone OTP via Verify)
# true = send real SMS | false = skip / log-only in development
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
# Optional: Messaging API From number (E.164), if not using Verify-only
TWILIO_PHONE_NUMBER=

# SendGrid (email OTP — preferred when enabled)
SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_SENDER_EMAIL=

# SMTP (email OTP — signup / forgot password)
# true = send real email | false = return debugCode in development
SMTP_ENABLED=false
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional From address (defaults to SMTP_USER)
# SMTP_FROM=noreply@onevibe.ai

# OpenAI (hashtag / caption generation — Linkgram-compatible common APIs)
OPENAI_API_KEY=
OPENAI_DAILY_LIMIT=3

# Agora RTC (audio / video calls) — certificate stays server-side only
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Firebase Cloud Messaging (device push)
# true = send real FCM pushes | false = skip (creds can stay set)
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep quotes; use \n for PEM newlines
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Apple PushKit VoIP (iOS CallKit when locked/killed)
# REQUIRED for background ringing. Without these, voip_token in DB is useless.
# Topic must be: <ios-bundle-id>.voip  (e.g. com.onevibe.app.voip)
# APNS_PRODUCTION=true for TestFlight/App Store; false for Xcode debug builds.
# Mismatch → BadDeviceToken on some phones (e.g. iPhone 8 debug vs 11 TestFlight).
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=
# Keep quotes; use \n for PEM newlines
APNS_PRIVATE_KEY=
APNS_VOIP_TOPIC=
APNS_PRODUCTION=true

# Wallet admin (comma-separated public user UUIDs) + IAP verify mode
# ADMIN_USER_UUIDS=uuid-1,uuid-2
# true = skip Google/Apple (web/dev). Production: false
IAP_SKIP_STORE_VERIFY=true

# Google Play Developer API (one-time product purchases)
GOOGLE_PLAY_CLIENT_EMAIL=
# Keep quotes; use \n for PEM newlines
GOOGLE_PLAY_PRIVATE_KEY=
GOOGLE_PLAY_PACKAGE_NAME=com.app.onevibe

# App Store Server API (StoreKit 2 transaction lookup)
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
# Keep quotes; use \n for PEM newlines
APPLE_IAP_PRIVATE_KEY=
APPLE_IAP_BUNDLE_ID=com.onevibe.live

# Social login — Google / Apple (server-side ID token verify)
# Comma-separated OAuth client IDs used as JWT audiences.
# Web: use the Firebase Google "Web client ID" (….apps.googleusercontent.com).
# Apple: Services ID used by Firebase Apple provider / Sign in with Apple.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Rate limit / scale knobs
# Global IP limit (production). Off in development unless RATE_LIMIT_ENABLED=true.
# 0 = disable global limit. Window should stay short (e.g. 60s) — long windows lock you out for hours.
RATE_LIMIT_MAX=1000
RATE_LIMIT_TIME_WINDOW_MS=60000
# RATE_LIMIT_ENABLED=true

# OpenAPI UI at /docs (omit = on outside production)
SWAGGER_ENABLED=true

# Share / Universal Links (deeplink module — Linkgram parity)
# Empty DEEPLINK_PUBLIC_URL → uses API_PUBLIC_URL
# Profile share URL: {DEEPLINK_PUBLIC_URL}/api/v1/share/{username}
#   e.g. https://app.onevibe.ai/api/v1/share/dani.entakly
# DEEPLINK_PUBLIC_URL=https://app.onevibe.ai
DEEPLINK_SCHEME=onevibe
APP_STORE_URL=https://apps.apple.com/us/app/onevibe-live/id6758932009
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.app.onevibe
DEEPLINK_OG_IMAGE_URL=https://onevibe.ai/logo.jpg
DEEPLINK_IOS_APP_STORE_ID=6758932009
DEEPLINK_IOS_APP_IDS=56LQJGKNZA.com.app.onevibe,56LQJGKNZA.com.onevibe.live
DEEPLINK_ANDROID_PACKAGE=com.app.onevibe
# Comma-separated SHA-256 fingerprints (upload key + any other signing keys)
DEEPLINK_ANDROID_SHA256_FINGERPRINTS=C6:F2:09:F4:6D:86:DE:34:F9:39:D8:30:7D:95:D6:34:AB:99:A4:BD:23:9C:2F:B3:47:1A:29:DB:65:66:DC:BB,14:16:8B:90:A1:17:DC:F7:09:DE:5A:24:0C:97:A3:1A:CF:B4:D0:F8:1C:EE:7B:0E:AB:34:13:C7:FD:BF:22:7B

# Logging
LOG_LEVEL=info
