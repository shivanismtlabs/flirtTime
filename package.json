{
  "name": "onevibe",
  "version": "1.0.0",
  "description": "OneVibe — scalable social platform (Fastify + Socket.IO)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "tsx watch src/apps/api/index.ts",
    "dev:adminapis": "tsx watch src/apps/adminapis/index.ts",
    "dev:socket": "tsx watch src/apps/socket/index.ts",
    "dev": "concurrently -n api,socket -c blue,magenta \"npm:dev:api\" \"npm:dev:socket\"",
    "build": "tsc -p tsconfig.json && node --import tsx scripts/copy-assets.ts",
    "start:api": "node dist/apps/api/index.js",
    "start:adminapis": "node dist/apps/adminapis/index.js",
    "start:socket": "node dist/apps/socket/index.js",
    "start": "concurrently -n api,socket -c blue,magenta \"npm:start:api\" \"npm:start:socket\"",
    "db:migrate": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:latest",
    "db:rollback": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:rollback",
    "db:seed": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run",
    "db:seed:gifts": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run --specific=02_gifts.ts",
    "db:seed:countries": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run --specific=03_countries.ts",
    "db:seed:admin": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run --specific=04_admin.ts",
    "db:seed:coin-packages": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run --specific=05_coin_packages.ts",
    "db:seed:onevibeapp": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts seed:run --specific=06_from_onevibeapp.ts",
    "db:sync:onevibeapp": "tsx scripts/sync-from-onevibeapp.ts",
    "db:dump:onevibeapp": "tsx scripts/dump-onevibeapp.ts",
    "deploy:prod": "bash scripts/deploy-production.sh",
    "db:make": "node --import tsx ./node_modules/knex/bin/cli.js --knexfile knexfile.ts migrate:make",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-lambda": "^3.1098.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^9.0.4",
    "@fastify/multipart": "^10.1.0",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@parse/node-apn": "^6.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "agora-token": "^2.0.5",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^11.0.0",
    "ioredis": "^5.4.2",
    "jose": "^6.2.6",
    "knex": "^3.1.0",
    "leo-profanity": "^1.9.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.48.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "translate-google": "^1.5.0",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.1098.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/leo-profanity": "^1.5.5",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "esbuild@0.28.1": true,
    "protobufjs@7.6.6": true
  }
}
